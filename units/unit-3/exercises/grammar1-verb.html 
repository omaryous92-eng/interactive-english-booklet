    // QUESTIONS — EXACTLY AS IN THE BOOKLET (Page 76)
    const questions = [
      { type: 'fill', text: '1. I _______ (work) all day, so I didn\'t want to go out.', correct: 'had been working' },
      { type: 'fill', text: '2. She _______ (sleep) for ten hours when I woke her.', correct: 'had been sleeping' },
      { type: 'fill', text: '3. They _______ (live) in Beijing for three years when he lost his job.', correct: 'had been living' },
      { type: 'fill', text: '4. I had to have a break. I _______ so long. (drive)', correct: 'had been driving' },
      { type: 'fill', text: '5. Before we parked our car we _______ the ticket. (collect)', correct: 'had collected' },
      { type: 'fill', text: '6. I arrived on Sunday. I _______ at home for two days. (not be)', correct: 'had not been' },
      { type: 'fill', text: '7. The roads were blocked in the morning. It _______ all night. (snow)', correct: 'had been snowing' },
      { type: 'fill', text: '8. They got to the beach after they _______ for hours. (walk)', correct: 'had been walking' },
      { type: 'fill', text: '9. She called the police when she _______ the light in the hall. (see)', correct: 'had seen' },
      { type: 'fill', text: '10. His English was perfect. He _______ it since he started school. (study)', correct: 'had been studying' },
      { type: 'fill', text: '11. After finishing his drink he got up. (Rewrite)', correct: 'After he had finished his drink, he got up.' },
      { type: 'fill', text: '12. His driving too fast caused an accident. (Rewrite)', correct: 'He had an accident because he had been driving too fast.' },
      { type: 'fill', text: '13. Everyone sat down. The show started. (Rewrite)', correct: 'The show started when everyone had sat down.' },
      { type: 'fill', text: '14. After switching on the radio she heard the news. (Rewrite)', correct: 'After she had switched on the radio, she heard the news.' },
      { type: 'fill', text: '15. The ship sailed for two days. It landed in Nice. (Rewrite)', correct: 'The ship landed in Nice after it had sailed for two days.' }
    ];

